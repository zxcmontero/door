# Профиль: test является безопасным значением по умолчанию
APP_ENV=test
ACTUATOR_MODE=test

# Telegram
BOT_TOKEN=replace_with_real_bot_token
BOT_USERNAME=
ADMIN_IDS=123456789
LOG_CHAT_ID=

# HTTP и reverse proxy
PUBLIC_BASE_URL=
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
TRUSTED_PROXY_IPS=
HTTP_GET_RATE_PER_MINUTE=30
HTTP_POST_RATE_PER_MINUTE=10
RATE_LIMIT_BLOCK_SECONDS=60
HTTP_IDEMPOTENCY_RETENTION_SECONDS=86400

# Dahua: заполняется только для реального actuator после стендовой приемки
DAHUA_IP=192.168.1.108
DAHUA_USER=admin
DAHUA_PASS=replace_with_real_password
DAHUA_RTSP_PORT=554
DAHUA_CHANNEL=1
ACTUATOR_OPEN_TTL_SECONDS=5
ACTUATOR_TIMEOUT_SECONDS=10

# Хранение и модели
DATABASE_PATH=data/access.db
MODEL_DIR=data/models
FACE_ENROLLMENT_DIR=data/enrollment
REJECTION_SNAPSHOT_DIR=data/rejections
REJECTION_SNAPSHOTS_ENABLED=false

# Видео и decision engine
RTSP_FPS=10
FRAME_MAX_AGE_SECONDS=2.0
FACE_ANALYSIS_INTERVAL=0.2
MIN_FACE_WIDTH_PX=80
FACE_DET_SCORE=0.60
FACE_SIMILARITY_THRESHOLD=
FACE_CONFIRMATIONS_REQUIRED=4
FACE_CONFIRMATION_WINDOW_SECONDS=3.0
DOOR_UNLOCK_COOLDOWN_SECONDS=10
MOTION_TAIL_SECONDS=2.5
PRESENCE_PERSON_SECONDS=5.0
PRESENCE_MOTION_SECONDS=4.0
COURIER_PRESENCE_SECONDS=3.0

# Liveness и вычисления
LIVENESS_MODEL_PATH=
LIVENESS_THRESHOLD=
EXECUTION_PROVIDER=CUDA
ALLOW_CPU_FALLBACK=true
OPENCV_THREADS=1

# IPC, outbox и курьеры
IPC_COMMAND_TTL_SECONDS=15
OUTBOX_POLL_SECONDS=0.5
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_MAX_BACKOFF_SECONDS=300
COURIER_FACE_TTL_SECONDS=600
COURIER_UNLOAD_SECONDS=600

# Retention и эксплуатация
IPC_RETENTION_SECONDS=86400
OUTBOX_RETENTION_SECONDS=2592000
QR_RETENTION_SECONDS=2592000
AUDIT_RETENTION_SECONDS=7776000
REJECTION_SNAPSHOT_RETENTION_SECONDS=604800
LOG_LEVEL=INFO
METRICS_HOST=127.0.0.1
METRICS_PORT=9090
