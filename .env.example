# Telegram
BOT_TOKEN=replace_with_real_bot_token
BOT_USERNAME=door
ADMIN_IDS=123456789
LOG_CHAT_ID=-1001234567890

# Dahua VTO: адрес указывается без http:// и без завершающего /
DAHUA_IP=192.168.1.108
DAHUA_USER=admin
DAHUA_PASS=replace_with_real_password
DAHUA_RTSP_PORT=554

# Хранилище и временные файлы
DATABASE_PATH=data/access.db
MEDIA_DIR=data/media
FACE_TASKS_DIR=data/face_tasks
TEMP_MEDIA_DIR=/tmp

# HTTP-ссылки в QR; пустой PUBLIC_BASE_URL сохраняет Telegram deep link
PUBLIC_BASE_URL=
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Видео и контроль доступа
RTSP_FPS=10
PRE_ROLL_SECONDS=3
POST_ROLL_SECONDS=5
LIVE_CLIP_SECONDS=4
FACE_ANALYSIS_INTERVAL=0.2
FACE_SIMILARITY_THRESHOLD=0.48
FACE_COOLDOWN_SECONDS=20
DOOR_UNLOCK_COOLDOWN_SECONDS=8
COURIER_FACE_TTL_SECONDS=600
